{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "slippagePct": {
      "type": "number",
      "description": "Allowed slippage for swap transactions (as a percentage)",
      "minimum": 0,
      "maximum": 100
    },
    "apiKey": {
      "type": "string",
      "description": "API key for the Fibrous API (optional)"
    },
    "requestTimeout": {
      "type": "integer",
      "description": "Request timeout for API calls (ms)",
      "minimum": 0
    },
    "enableLogging": {
      "type": "boolean",
      "description": "Enable/disable request logging"
    }
  },
  "required": ["slippagePct"],
  "additionalProperties": false
}
