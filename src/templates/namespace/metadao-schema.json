{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "programId": {
      "type": "string",
      "description": "MetaDAO Futarchy program ID"
    },
    "conditionalVaultProgramId": {
      "type": "string",
      "description": "Conditional vault program ID"
    },
    "defaultSlippagePct": {
      "type": "number",
      "description": "Default slippage percentage (e.g., 0.5 for 0.5%)"
    }
  },
  "additionalProperties": false,
  "required": ["programId", "conditionalVaultProgramId", "defaultSlippagePct"]
}
