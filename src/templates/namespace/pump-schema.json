{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "slippagePct": {
      "type": "number",
      "description": "Default slippage percentage (e.g., 1 for 1%)"
    },
    "lookupTableAddress": {
      "type": "string",
      "description": "Address lookup table that fits create-token + dev buy in one v0 transaction; empty refuses a create with a dev buy"
    }
  },
  "additionalProperties": false,
  "required": ["slippagePct", "lookupTableAddress"]
}
